{
  "manifest_version": 3,
  "name": "Selector - Visual Element Picker",
  "version": "1.2.7",
  "description": "Select page elements visually and copy a structured prompt with selectors, text, HTML, and React component details.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "AI Element Picker",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "assets/storage-bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "assets/editor.js"
      ],
      "css": [
        "assets/editor.css"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
